{
  "id": "edgeever-enhancing-export",
  "name": "Enhancing Export",
  "version": "1.0.10",
  "description": "Enhanced export for EdgeEver with HTML, Word, PDF, Markdown and blog export.",
  "author": "zyhcs",
  "main": "main.js",
  "styles": "styles.css",
  "settings": [
    {
      "key": "default_format",
      "type": "select",
      "label": "Default Export Format",
      "default": "html",
      "options": [
        {
          "value": "html",
          "label": "Standalone HTML (.html)"
        },
        {
          "value": "doc",
          "label": "Word Document (.doc)"
        },
        {
          "value": "pdf",
          "label": "High-Fidelity Print / PDF"
        },
        {
          "value": "md",
          "label": "Standard Markdown (.md)"
        },
        {
          "value": "hugo",
          "label": "Blog Markdown (Hugo/Hexo)"
        }
      ]
    },
    {
      "key": "default_font_size",
      "type": "select",
      "label": "Default Font Size",
      "default": "15",
      "options": [
        {
          "value": "13",
          "label": "Compact Small (13px)"
        },
        {
          "value": "14",
          "label": "Standard (14px)"
        },
        {
          "value": "15",
          "label": "Comfortable Medium (15px)"
        },
        {
          "value": "16",
          "label": "Large (16px)"
        },
        {
          "value": "18",
          "label": "Extra Large (18px)"
        }
      ]
    },
    {
      "key": "button_position",
      "type": "select",
      "label": "Enhancing Export Button Position",
      "default": "toolbar",
      "options": [
        {
          "value": "toolbar",
          "label": "Editor Toolbar (recommended)"
        },
        {
          "value": "fab",
          "label": "Floating Button Bottom Right"
        },
        {
          "value": "hidden",
          "label": "Hidden Button"
        }
      ]
    },
    {
      "key": "embed_images_base64",
      "type": "boolean",
      "label": "Embed images as Base64",
      "default": true
    },
    {
      "key": "include_frontmatter",
      "type": "boolean",
      "label": "Include YAML Frontmatter Metadata",
      "default": true
    },
    {
      "key": "pandoc_path",
      "type": "text",
      "label": "Pandoc Executable Path",
      "default": "pandoc"
    }
  ]
}
